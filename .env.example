APP_USERNAME=admin
APP_PASSWORD=cambiala-por-una-segura

# Clave secreta para firma criptográfica de sesiones Flask (genera una aleatoria de 32+ caracteres)
# Si se deja vacía, dHtools generará una clave aleatoria persistente automáticamente en el primer inicio.
FLASK_SECRET_KEY=genera_una_clave_aleatoria_super_segura_de_32_caracteres

# Actualización automática de yt-dlp
AUTO_UPDATE_YTDLP=true
AUTO_UPDATE_INTERVAL_HOURS=24

# Limpieza automática de archivos descargados
CLEANUP_AFTER_HOURS=24
CLEANUP_CHECK_INTERVAL_MINUTES=30

# Proveedor de PO Tokens (necesario para descargar en alta calidad, ver README sección 5c)
POT_PROVIDER_URL=http://potprovider:4416

# Orden de clientes de YouTube que prueba yt-dlp (separados por coma, sin espacios).
# Ver README sección 5c antes de tocar esto — es un ajuste que cambia seguido según
# qué cliente esté funcionando mejor esta semana en la carrera YouTube vs yt-dlp.
PLAYER_CLIENTS=tv,web,android

# Motor Cobalt (beta) — segundo motor de descarga, ver README sección 9
COBALT_URL=http://cobalt:9000/
