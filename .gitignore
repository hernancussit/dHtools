# Entorno y credenciales sensibles (¡Nunca subir!)
.env
.flask_secret
cookies.txt
users.json
config.json
cloud_sync.json
downloads_meta.json
queue_state.json
rollback_state.json


# Archivos de descargas temporales
downloads/*
!downloads/.gitkeep

# Backups locales
.backups/
*.zip

# Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
scratch/

# Archivos de sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.agents/

# Sistema Experimental de Plugins (Aislamiento Privado)
plugins/*
!plugins/.gitkeep
!plugins/README.md
!plugins/template_example/

# Plugins Oficiales Bundled (Código rastreado, credenciales ignoradas)
!plugins/google_drive/
plugins/google_drive/config.json
plugins/google_drive/service_account.json
plugins/google_drive/token.json
plugins/google_drive/*.credentials.json
plugins/google_drive/users_data/

!plugins/onedrive/
plugins/onedrive/config.json
plugins/onedrive/token.json
plugins/onedrive/users_data/

!plugins/dropbox/
plugins/dropbox/config.json
plugins/dropbox/token.json
plugins/dropbox/users_data/




